# Copie este arquivo para .env e preencha os valores
# Caminho: fap\.env

# Credenciais do PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fap
DB_USER=postgres
DB_PASSWORD=sua_senha

# Personal Access Token do GitHub 
# https://github.com/settings/tokens  -> gera um token "classic" com permissão de leitura public_repo
GITHUB_TOKEN=coloque_seu_token_aqui

# Configuração da coleta
MESES_ANALISE=6
