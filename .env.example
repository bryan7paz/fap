# Copie este arquivo para .env e preencha os valores
# Caminho: fap\.env

# Credenciais do PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fap
DB_USER=postgres
DB_PASSWORD=sua_senha

# Personal Access Token do GitHub 
# https://github.com/settings/tokens  -> gera um token "classic" com permiss意味ao de leitura public_repo
GITHUB_TOKEN=coloque_seu_token_aqui

# Login OAuth com GitHub (opcional; sem isso vale o /login/dev)
# Crie um OAuth App em https://github.com/settings/developers
# Authorization callback URL: http://127.0.0.1:5000/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Configuração da coleta
MESES_ANALISE=6
